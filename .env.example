# Server-only secrets. Never prefix with NEXT_PUBLIC_. Put real values in .env.local (gitignored) or Render env vars.
NICRRON_API_KEY=
# Exact Nicrron model id (OpenAI-compatible). Defaults to anthropic/claude-fable-5-1.
NICRRON_MODEL=anthropic/claude-fable-5-1
NICRRON_BASE_URL=https://api.nicrron.ai/v1
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# PRISM tracing (HTTP ingest)
PRISMTRACE_API_KEY=
PRISMTRACE_PROJECT_ID=
PRISMTRACE_HOST=https://prism-api-prod.up.railway.app
